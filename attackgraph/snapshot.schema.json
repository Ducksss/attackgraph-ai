{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:attackgraph-ai:snapshot:1.0",
  "title": "AttackGraph AI synthetic snapshot",
  "description": "A hand-authored synthetic configuration snapshot. It declares resolved facts for a small security model. It is not a raw AWS policy format, and labels confer no permissions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "synthetic",
    "model_version",
    "coverage",
    "nodes",
    "facts",
    "entry_principals",
    "protected_targets",
    "expected_access"
  ],
  "properties": {
    "schema_version": {
      "description": "Snapshot format version.",
      "const": "1.0"
    },
    "snapshot_id": {
      "$ref": "#/$defs/id"
    },
    "name": {
      "description": "Display name only.",
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "synthetic": {
      "description": "Must be true. Only synthetic fixtures are accepted.",
      "const": true
    },
    "model_version": {
      "description": "Security model the facts were authored against.",
      "const": "attackgraph-rules-v1"
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "facts": {
      "type": "array",
      "maxItems": 300,
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "entry_principals": {
      "description": "Principal node IDs from which reachability is evaluated. Treating one as controlled is a scenario assumption.",
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "protected_targets": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/protected_target"
      }
    },
    "expected_access": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/expected_access"
      }
    }
  },
  "$defs": {
    "id": {
      "description": "Stable identifier: lower-case letters, digits, '.', '_' or '-', at most 64 characters.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "resolution": {
      "enum": ["resolved", "unresolved"]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_controls", "unmodelled_mechanisms"],
      "properties": {
        "policy_controls": {
          "description": "resolved: the control's effect is already reflected in the declared fact states, or the control is not used. unresolved: it may apply and is not reflected, so analysis is incomplete.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "permissions_boundaries",
            "service_control_policies",
            "resource_policies",
            "conditions",
            "explicit_denies"
          ],
          "properties": {
            "permissions_boundaries": {
              "$ref": "#/$defs/resolution"
            },
            "service_control_policies": {
              "$ref": "#/$defs/resolution"
            },
            "resource_policies": {
              "$ref": "#/$defs/resolution"
            },
            "conditions": {
              "$ref": "#/$defs/resolution"
            },
            "explicit_denies": {
              "$ref": "#/$defs/resolution"
            }
          }
        },
        "unmodelled_mechanisms": {
          "description": "Access mechanisms present in the scenario that this model does not evaluate. Any entry makes coverage incomplete.",
          "type": "array",
          "uniqueItems": true,
          "maxItems": 10,
          "items": {
            "enum": [
              "general_assume_role",
              "ec2_instance_profiles",
              "cross_account_access",
              "other_service_role_passing",
              "other"
            ]
          }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label", "account_id"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": ["principal", "role", "lambda", "s3_object"]
        },
        "label": {
          "description": "Display text only. Never sent to the language model and never used to infer privilege.",
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "account_id": {
          "description": "Synthetic account identifier. The syn- prefix keeps real 12-digit AWS account numbers out of fixtures.",
          "type": "string",
          "pattern": "^syn-[a-z0-9-]{1,32}$"
        }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "predicate", "subject", "state"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "predicate": {
          "enum": [
            "s3_get_object",
            "iam_pass_role_to_lambda",
            "lambda_create_function",
            "lambda_invoke_function",
            "controls_workload_code",
            "role_trusts_lambda_service"
          ]
        },
        "subject": {
          "$ref": "#/$defs/id"
        },
        "object": {
          "$ref": "#/$defs/id"
        },
        "state": {
          "enum": ["true", "false", "unknown"]
        }
      }
    },
    "protected_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "classification"],
      "properties": {
        "node": {
          "$ref": "#/$defs/id"
        },
        "classification": {
          "enum": ["privileged_role", "sensitive_object"]
        }
      }
    },
    "expected_access": {
      "description": "Ordinary access that a fix should preserve. The principal must be an entry principal.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "principal", "target", "relationship"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "principal": {
          "$ref": "#/$defs/id"
        },
        "target": {
          "$ref": "#/$defs/id"
        },
        "relationship": {
          "enum": ["object_read", "role_use"]
        }
      }
    }
  }
}
